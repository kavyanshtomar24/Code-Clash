# Use localhost when running API directly on the host.
# docker-compose overrides these with postgres/redis service hostnames.
DATABASE_URL=postgresql+asyncpg://cpuser:cppassword@localhost:5432/cpplatform
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CODEFORCES_API_URL=https://codeforces.com/api
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://code-clash-omega.vercel.app"]
CORS_ORIGIN_REGEX=https://code-clash.*\.vercel\.app
DEBUG=true
ADMIN_USERNAMES=["admin"]
JUDGE_ENABLED=true
